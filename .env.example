# Keep the working demo in Mock mode. Set false to enable LLM calls when all credentials are configured.
MOCK_MODE=true

# Server-only settings. Never prefix secrets with NEXT_PUBLIC_.
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# Phase 4 news provider (Tavily by default; NEWS_API_URL can point to a compatible provider adapter):
# Get a key at https://app.tavily.com/
# NEWS_API_URL=https://api.tavily.com/search
# NEWS_API_KEY=
# NEWS_TIMEOUT_MS=20000
# LLM_TIMEOUT_MS=30000
# LLM_MAX_RETRIES=1
# LLM_MAX_CONCURRENCY=3
